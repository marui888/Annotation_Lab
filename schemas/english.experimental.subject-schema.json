{
  "schemaVersion": 1,
  "subjectId": "english-experimental",
  "label": "英语-实验版",
  "description": "面向初高中英语教学、词汇短语、句型句式、翻译、写作、发音和语法语用的简化主题语义模型。除翻译练习外，其它 Kind 使用 default 角色；特征属性沿用基础部分和关键词部分。",
  "version": "0.1.0",
  "entityKinds": [
    {
      "value": "wordPhrase",
      "label": "单词短语",
      "description": "单词、短语、固定搭配、词义、用法和例句。",
