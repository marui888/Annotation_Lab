    },
    {
      "value": "translation",
      "label": "翻译中英",
      "description": "中英表达、译文对照、翻译策略和中英差异。"
    },
    {
      "value": "translationTask",
      "label": "翻译练习",
      "description": "用于训练或讲评的翻译练习，包含原文和译文。"
    },
    {
      "value": "writing",
      "label": "写作表达",
      "description": "写作素材、表达优化、衔接、修辞和语篇组织。"
    },
    {
      "value": "pronunciation",
      "label": "发音变音",
      "description": "音标、连读、弱读、变音、多音和发音规则。"
    },
    {
      "value": "grammarUsage",
      "label": "语法语用",
      "description": "语法现象、语用差异、结构分析、规则和例外。"
